{
  "title": "Step response of an RC load",
  "desc": "The generator claims τ = 3 ns, but the figure was computed with τ = 2 ns.",
  "x": { "label": "time", "unit": "ns", "min": 0, "max": 10, "var": "t" },
  "y": { "label": "voltage", "unit": "V", "min": 0, "max": 1.2 },
  "params": { "tau": 3 },
  "series": [
    { "label": "v(t) = 1 − e^(−t/τ)", "expr": "1 - exp(-t / tau)" },
    { "label": "63 % at t = τ", "expr": "1 - exp(-1)", "dash": true }
  ]
}

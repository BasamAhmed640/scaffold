{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "state": {
      "default": "all",
      "type": "string",
      "enum": [
        "candidate",
        "open",
        "resolved",
        "all"
      ]
    }
  }
}

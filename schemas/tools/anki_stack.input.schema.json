{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "subject": {
      "type": "string",
      "maxLength": 120
    },
    "kc_ids": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
      }
    },
    "tags": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "forgotten",
        "fragile",
        "misconception",
        "check"
      ]
    }
  },
  "required": [
    "name"
  ]
}

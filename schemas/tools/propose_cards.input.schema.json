{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^S-\\d{4}-\\d{2}-\\d{2}-\\d+$"
    },
    "cards": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kc_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
          },
          "note_type": {
            "default": "basic",
            "type": "string",
            "enum": [
              "basic",
              "cloze"
            ]
          },
          "front": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "back": {
            "default": "",
            "type": "string",
            "maxLength": 1000
          },
          "extra": {
            "default": "",
            "type": "string",
            "maxLength": 1000
          },
          "anchor": {
            "default": false,
            "type": "boolean"
          },
          "admission": {
            "type": "object",
            "properties": {
              "rederive": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300
              },
              "instant": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300
              },
              "worth": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300
              }
            },
            "required": [
              "rederive",
              "instant",
              "worth"
            ]
          }
        },
        "required": [
          "kc_id",
          "front",
          "admission"
        ]
      }
    },
    "by": {
      "default": "tutor",
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    }
  },
  "required": [
    "cards"
  ]
}

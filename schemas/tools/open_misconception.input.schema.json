{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kc_ids": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
      }
    },
    "belief": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "misconception_id": {
      "type": "string",
      "pattern": "^M-\\d{4,}$"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^S-\\d{4}-\\d{2}-\\d{2}-\\d+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    }
  },
  "required": [
    "kc_ids",
    "belief",
    "by"
  ]
}

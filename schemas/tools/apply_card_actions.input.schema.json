{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action_ids": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CA-\\d{4,}$"
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "learner_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "learner_quote"
      ]
    },
    "edits": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "front": {
            "type": "string",
            "maxLength": 1000
          },
          "back": {
            "type": "string",
            "maxLength": 1000
          },
          "extra": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  },
  "required": [
    "action_ids",
    "approval"
  ]
}

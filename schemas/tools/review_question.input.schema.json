{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^Q-\\d{4,}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "ok",
        "fix",
        "reject"
      ]
    },
    "by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "notes": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "question_id"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "scope": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "closed"
      ]
    }
  },
  "required": [
    "subject",
    "scope"
  ]
}

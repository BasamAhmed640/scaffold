{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "note_id": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "kc_ids": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
      }
    },
    "reason": {
      "default": "tutor_check",
      "type": "string",
      "enum": [
        "tutor_check",
        "explanation_changed",
        "answer_key_changed",
        "source_changed",
        "review_by_passed",
        "leech"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "proposed": {
      "type": "string",
      "enum": [
        "retire",
        "rewrite",
        "keep",
        "check"
      ]
    },
    "by": {
      "default": "tutor",
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    }
  },
  "required": [
    "detail",
    "proposed"
  ]
}

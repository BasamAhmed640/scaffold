{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 40
    },
    "grade": {
      "type": "string",
      "enum": [
        "correct",
        "partial",
        "incorrect",
        "unanswered"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "by": {
      "default": "owner",
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    }
  },
  "required": [
    "attempt_id",
    "grade",
    "reason"
  ]
}

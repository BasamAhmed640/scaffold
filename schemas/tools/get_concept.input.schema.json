{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kc_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "include_text": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "kc_id"
  ]
}

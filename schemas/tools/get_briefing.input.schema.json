{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "focus": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "minutes": {
      "type": "number",
      "minimum": 5,
      "maximum": 240
    },
    "carryover": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    }
  }
}

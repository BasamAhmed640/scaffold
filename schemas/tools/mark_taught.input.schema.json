{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kc_ids": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
      }
    },
    "visual_ids": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^V-\\d{4,}$"
      }
    },
    "note": {
      "default": "",
      "type": "string",
      "maxLength": 500
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^S-\\d{4}-\\d{2}-\\d{2}-\\d+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kc_ids"
  ]
}
